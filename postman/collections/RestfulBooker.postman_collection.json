{
  "info": {
    "_postman_id": "31b54d14-5be1-4a7f-9082-b611146ce4c0",
    "name": "Restful Booker API",
    "description": "Smoke and CRUD tests for https://restful-booker.herokuapp.com. Run requests in order so the create request can populate bookingId for later requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/ping",
          "host": ["{{baseUrl}}"],
          "path": ["ping"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health check returns 201', function () {",
              "  pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create auth token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth",
          "host": ["{{baseUrl}}"],
          "path": ["auth"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Authentication returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response contains an auth token', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('token').that.is.a('string').and.not.empty;",
              "  pm.environment.set('token', body.token);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstname\": \"Jim\",\n  \"lastname\": \"Brown\",\n  \"totalprice\": 111,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-10-10\",\n    \"checkout\": \"2026-10-15\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/booking",
          "host": ["{{baseUrl}}"],
          "path": ["booking"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Booking is created with 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response contains a booking ID and booking details', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('bookingid').that.is.a('number');",
              "  pm.expect(body).to.have.property('booking');",
              "  pm.environment.set('bookingId', body.bookingid);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get created booking",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingId}}",
          "host": ["{{baseUrl}}"],
          "path": ["booking", "{{bookingId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Booking lookup returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Booking response includes required fields', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('firstname');",
              "  pm.expect(body).to.have.property('lastname');",
              "  pm.expect(body).to.have.property('bookingdates');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update booking",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "token={{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstname\": \"James\",\n  \"lastname\": \"Brown\",\n  \"totalprice\": 222,\n  \"depositpaid\": false,\n  \"bookingdates\": {\n    \"checkin\": \"2026-10-11\",\n    \"checkout\": \"2026-10-16\"\n  },\n  \"additionalneeds\": \"Late checkout\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingId}}",
          "host": ["{{baseUrl}}"],
          "path": ["booking", "{{bookingId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Full booking update returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Full update persists the new first name', function () {",
              "  pm.expect(pm.response.json().firstname).to.eql('James');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Partially update booking",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "token={{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"additionalneeds\": \"Airport pickup\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingId}}",
          "host": ["{{baseUrl}}"],
          "path": ["booking", "{{bookingId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Partial booking update returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Partial update keeps other booking fields', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.additionalneeds).to.eql('Airport pickup');",
              "  pm.expect(body.firstname).to.eql('James');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List booking IDs",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/booking?firstname=James&lastname=Brown",
          "host": ["{{baseUrl}}"],
          "path": ["booking"],
          "query": [
            {
              "key": "firstname",
              "value": "James"
            },
            {
              "key": "lastname",
              "value": "Brown"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Booking search returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Booking search response is an array', function () {",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete booking",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Cookie",
            "value": "token={{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingId}}",
          "host": ["{{baseUrl}}"],
          "path": ["booking", "{{bookingId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Booking deletion returns 201', function () {",
              "  pm.response.to.have.status(201);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Confirm deleted booking is not found",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingId}}",
          "host": ["{{baseUrl}}"],
          "path": ["booking", "{{bookingId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Deleted booking returns 404', function () {",
              "  pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
